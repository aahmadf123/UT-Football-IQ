# ─────────────────────────────────────────────────────────────────────────────
# Football-IQ — Environment Variables Template
#
# Copy this file to .env and fill in real values.
# NEVER commit .env or any file containing real secrets.
#
# Defaults describe a single-box setup: local Postgres, local disk for objects,
# and no cloud account of any kind. Hosting, object storage, and deployment are
# deliberately unconfigured — pick providers and fill them in.
#
# See README.md for how the services fit together.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────────
ENVIRONMENT=development           # development | staging | production
SECRET_KEY=changeme-at-least-32-chars-long
LOG_LEVEL=INFO

# ── Database (Postgres) ───────────────────────────────────────────────────────
# Point these at any Postgres 16+ with the pgvector extension available.
# Local: the values below assume a database named `footiq` on localhost.
# Managed: replace with your provider's connection string.
DATABASE_URL=postgresql+asyncpg://footiq:footiq_dev@localhost:5432/footiq
# Sync URL used by Alembic migrations only
DATABASE_SYNC_URL=postgresql://footiq:footiq_dev@localhost:5432/footiq

# ── Object storage (any S3-compatible provider) ──────────────────────────────
# Only needed when STORAGE_BACKEND=s3 (see "Storage backend" below). Leave
# blank to run entirely on local disk. Works with any S3-compatible endpoint —
# AWS S3, MinIO, Backblaze B2, Cloudflare R2, etc.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT_URL=
S3_BUCKET_RAW=raw-video
S3_BUCKET_CLIPS=clips
S3_BUCKET_OVERLAYS=overlays
S3_BUCKET_ARTIFACTS=artifacts
# Presigned URL expiry in seconds (default: 3600 = 1 hour)
S3_PRESIGN_TTL=3600

# ── Frontend (public — safe to expose to browser) ────────────────────────────
# Baked into the bundle at BUILD time (the frontend is a static export), so a
# deployed build must be built with the deployed backend's origin.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Demo-only role override for client-side surface gating (Issue #113). When no
# JWT is present, this decides which role the UI renders as. Approved roles
# (admin | analyst | sportsperformance) reveal the Health & Workload surface;
# leave unset (defaults to "coach") to keep it hidden. Never a security
# boundary — the backend re-checks every request.
NEXT_PUBLIC_DEMO_ROLE=

# ── Auth / JWT ────────────────────────────────────────────────────────────────
# JWT algorithm: HS256 | RS256
JWT_ALGORITHM=HS256
# Access token lifetime in minutes
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
# Refresh token lifetime in days
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ── University SSO (optional) ─────────────────────────────────────────────────
# Set if university SSO / SAML / OAuth2 provider is available
SSO_PROVIDER_URL=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=

# ── GPU Worker ────────────────────────────────────────────────────────────────
# Queue polling interval in seconds
GPU_WORKER_POLL_INTERVAL=10
# Object-store creds are reused from the S3_* vars above.
# Optional: burst GPU provider (RunPod / Modal / Lambda Labs)
RUNPOD_API_KEY=
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# ── Capture-regime detector (Issue #126) ──────────────────────────────────────
# Minimum fusion confidence required to classify a clip as drone_follow or
# fixed_sideline. Below this threshold the detector falls back to "unknown".
REGIME_MIN_CONFIDENCE=0.55
# Optional uncertainty band around the decision boundary. Predictions within
# ±margin of 0.5 are labeled "unknown" instead of forcing a regime class.
REGIME_MARGIN=0.05
# Optional path to a joblib-serialized logistic-regression coefficient dict.
# When absent (the default), the detector uses a hand-tuned linear fallback so
# the pipeline works in dev/CI without a trained artifact.
REGIME_MODEL_PATH=

# ── Detection: players / ball / officials (Issues #128 / #133 / #148) ─────────
# Dedicated nano ball model weights (Issue #133). Never committed — supplied at
# deploy time. SAHI 128px tiling is applied automatically on drone_follow clips.
MODEL_BALL_PATH=yolov8n-ball.pt
# Ball detector confidence floor (the tiny ball needs a lower threshold).
BALL_DETECTION_CONF=0.25
# Run the dedicated ball detector alongside player detection (Issue #133).
DETECT_BALL_ENABLED=1
# Referee/official suppression (Issue #148): relabel striped officials so they
# are filtered before team/formation analysis. Relabels only — never deletes.
OFFICIAL_SUPPRESSION_ENABLED=1
# Combined stripe+bimodality score above which a detection is tagged official.
# Conservative by default to keep the player→official false-positive rate low.
OFFICIAL_SCORE_THRESHOLD=0.6

# ── Model routing: tracking & Re-ID (Issues #74 / #129 / #131) ────────────────
# GPU-worker only — these are read by gpu-worker/pipeline/model_router.py, NOT
# by the backend. Routing always flows through the router; same-session keeps
# the lightweight iou-tracker + Tesseract paths regardless of these flags.
#
# Upgrade the NIGHTLY track bucket to BoT-SORT (ECC camera-motion + ReID,
# Issue #129). Default off; same-session is never affected. If both this and
# ENABLE_SAM3_NIGHTLY are set, the SAM 3.1 mask tracker wins the nightly slot.
ENABLE_BOTSORT_NIGHTLY=0
# Upgrade the NIGHTLY detect/track buckets to SAM 3.1 + mask tracker (Issue #74).
ENABLE_SAM3_NIGHTLY=0
# Nightly jersey-number OCR upgrade (Issue #131). Format: parseq:/path/to.pt
# Weights are NEVER committed — mounted/downloaded at runtime. When unset or the
# checkpoint is missing, nightly re-ID falls back to Tesseract automatically.
REID_OCR_MODEL=
# Optional path to a JSON routing-override file (see model_routing.json shape).
MODEL_ROUTING_CONFIG=

# ── Pre-snap prediction models (Issues #135 / #136) ───────────────────────────
# GPU-worker only — optional TorchScript checkpoints for the formation MLP and
# motion-type LSTM (Issue #135). When unset or missing, the signal extractor
# uses its deterministic geometric/rule-based fallbacks (clearly flagged as
# such, never presented as a trained-model result). Weights are NEVER committed
# — mount or download them at runtime.
PLAY_PREDICTION_FORMATION_MODEL=
PLAY_PREDICTION_MOTION_MODEL=

# ── Coverage GNN + pre-snap pressure models (Issues #139 / #140) ──────────────
# GPU-worker only — optional offline-trained checkpoints (JSON) for the coverage
# classifier head and the pressure logistic model. When unset or missing, the
# coverage stage uses its deterministic graph/heuristic baseline and the pressure
# stage uses its deterministic logistic prior — both clearly flagged uncalibrated
# / experimental, never presented as validated results. A checkpoint trained on
# Big Data Bowl data is offline-pretraining/evaluation only until Toledo
# validation (#164). Weights/checkpoints are NEVER committed — mount or download
# them at runtime; no hard-coded paths.
COVERAGE_GNN_MODEL=
PRESSURE_MODEL=

# ── Observability ─────────────────────────────────────────────────────────────
# Port for GPU worker Prometheus metrics HTTP server
GPU_METRICS_PORT=9090

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. The DEPLOYED frontend's exact
# origin MUST be here or the browser blocks every API call — including
# login/register — before it reaches the backend (the #1 "login doesn't
# work in production" cause).
CORS_ORIGINS=http://localhost:3000
# Optional regex for origins that change per deploy (e.g. per-branch preview
# URLs). Empty by default — keep any expression you add scoped to your own
# hosting, never a whole provider's wildcard domain.
CORS_ORIGIN_REGEX=

# ── Same-session 90-second feedback loop (Issue #147) ─────────────────────────
# Clip confidence below this value is surfaced to coaches as
# "low_confidence" in the derived clip review state; calibrated high uncertainty
CLIP_LOW_CONFIDENCE_THRESHOLD=0.5

# ── Player development passport (Issue #7) ────────────────────────────────────
# A weekly development snapshot whose resolved identity confidence is below this
# value (or whose identity state is not known/probable) is forced experimental
# and can never be approved for player-facing use. Jersey OCR is never trusted
# as ground truth, so this gate keeps low-confidence identities from being
# silently attached to a player profile. Backend-only.
PLAYER_PROFILE_IDENTITY_CONFIDENCE_THRESHOLD=0.5

# ── CollegeFootballData (CFBD) — Issues #161/#162/#163 ────────────────────────
# American football (college) data only. BACKEND-ONLY: the key is read by the
# FastAPI backend / ingestion. NEVER expose it to the frontend, browser bundles,
# logs, or coach-visible errors. The read-only analytics API
# (/api/cfbd/*) serves cached Postgres rows and does not use the key.
CFBD_API_KEY=
CFBD_BASE_URL=https://api.collegefootballdata.com
# Cached CFBD rows older than this are flagged ``stale`` to the UI (hours).
CFBD_CACHE_STALE_AFTER_HOURS=168

# ── Zero-shot concept search (Issue #144) ─────────────────────────────────────
# GET /api/v1/concept-search resolves a free-text football concept query against
# the structured labels Football-IQ already trusts (formation / coverage /
# personnel / field zone) — no fine-tuning, no new vector DB. When true it may
# also expand grounded matches with an EXPERIMENTAL pgvector similarity pass over
# the existing play embeddings (Issue #8); those results are always flagged
# experimental/approximate. Set false to return grounded metadata matches only.
CONCEPT_SEARCH_EMBEDDING_EXPANSION=true

# ── CLIP text-tower search (Issue #195) ───────────────────────────────────────
# Gate for POST /api/v1/search/text — genuine CLIP text-tower zero-shot search
# that cosine-matches a free-text query against the raw playembeddings.clip_vector
# (512-d, CLIP shared text-image space). Off (default) → 503 gated. When on, the
# backend builds the query vector from an injected CLIP text tower OR the
# precomputed concept catalog (backend/app/data/concept_catalog.json — committed
# vectors, never CLIP weights; built offline via
# gpu-worker/scripts/build_concept_catalog.py). Read at runtime by the backend
# (app.routers.search), like the gpu-worker ENABLE_* routing flags. Results are
# always experimental/approximate and never promote to a label.
ENABLE_EMBEDDING_TEXT_SEARCH=false

# ── Sportradar NCAAFB API v7 — PROPOSED, NOT WIRED (spike Issue #165) ─────────
# Evaluated in reports/spike-issue165-sportradar-ncaafb-v7.md. Recommendation:
# DO NOT ADOPT now — defer behind a scoped live in-game feature; CFBD stays the
# authoritative college-football source. These names are PROPOSALS only and are
# intentionally left COMMENTED OUT: nothing in the backend reads them yet, so
# they are not added to backend/app/config.py Settings. If a future issue
# adopts Sportradar, uncomment, wire a backend-only client (mirror app/cfbd/),
# and send the key as the `x-api-key` HEADER. BACKEND-ONLY: never expose to the
# frontend, browser bundles, logs, PR/issue text, stored artifacts, or
# coach-visible errors, and never store it in the database. Commit NO value.
# SPORTRADAR_API_KEY=
# SPORTRADAR_BASE_URL=https://api.sportradar.com
# SPORTRADAR_ACCESS_LEVEL=trial
# SPORTRADAR_NCAAFB_VERSION=v7

# ── Kaggle / NFL Big Data Bowl — OFFLINE adapter only (Issue #164) ────────────
# American football (NFL tracking) data for OFFLINE pretraining / evaluation
# ONLY — not production runtime, not in the model router, and NOT Toledo film.
# The adapter (gpu-worker/datasets/bdb) never downloads or commits Kaggle data;
# it reads a LOCAL copy you download yourself (see gpu-worker/datasets/bdb/README.md).
#
# The secret is KAGGLE_API_TOKEN (NOT KAGGLE_KEY). The official `kaggle` CLI
# reads KAGGLE_USERNAME + KAGGLE_KEY, so bridge it at download time with
# `export KAGGLE_KEY=$KAGGLE_API_TOKEN`. NEVER expose these to the frontend,
# browser bundles, logs, PR/issue text, stored artifacts, coach-visible
# errors, or the database. These are NOT read by the backend, so they are NOT
# added to backend/app/config.py Settings. Commit NO value.
KAGGLE_USERNAME=
KAGGLE_API_TOKEN=
# Local, gitignored paths the offline adapter reads/writes (no data in Git):
BDB_DATA_DIR=
BDB_ARTIFACT_DIR=

# ── Governance: health/workload gating (Issue #113) ───────────────────────────
# Number of queued processing_jobs at-or-above which heavy endpoints (jobs
# create/retry, GPU-bound triggers) are gated with HTTP 503 workload_gated.
WORKLOAD_QUEUE_THRESHOLD=50
# Number of concurrently running processing_jobs that triggers saturation.
WORKLOAD_RUNNING_THRESHOLD=20
# Set to "true" to bypass gating entirely (incident workarounds only —
# audit logs continue to flow either way).
WORKLOAD_GATING_DISABLED=false

# ── Active-learning queue (Issues #145 / #146) ────────────────────────────────
# Calibrated-uncertainty prioritisation for the coach-review queue. Read by the
# backend only (app/active_learning.py). See docs/active-learning.md.
# Blend weight on normalised entropy vs. (1 - calibrated confidence), in [0, 1].
ACTIVE_LEARNING_ENTROPY_WEIGHT=0.5
# Priority floor for an uncalibrated output with no usable ranking signal.
ACTIVE_LEARNING_UNCALIBRATED_PRIORITY=0.6
# Fallback priority for a model output that carries no uncertainty signal.
ACTIVE_LEARNING_MISSING_PRIORITY=0.5

# ── Playbook overlays & assignment scoring (Issue #15) ────────────────────────
# Dark-launch guard: when false the /api/v1/playbook surface 404s entirely.
PLAYBOOK_ENABLED=true
# Resolved player-identity confidence below this (or a non-known/probable
# identity state) downgrades an assignment grade to "needs_review" instead of a
# negative grade — a low-confidence identity is never scored as a wrong assignment.
PLAYBOOK_IDENTITY_CONFIDENCE_THRESHOLD=0.6
# Cap on clips the workload-gated corpus (re)scoring endpoint will scan.
PLAYBOOK_SCORE_CORPUS_MAX_PLAYS=500

# ── Counterfactual coverage simulator (Issue #141) ────────────────────────────
# Offline/backend MVP only — there is NO coach-facing "What-if" frontend yet
# (blocked until calibrated uncertainty #146 + the IA decisions). When false the
# /api/v1/counterfactuals surface 404s entirely; the endpoint is coaching-staff
# only and every response is experimental regardless.
COUNTERFACTUAL_SIMULATOR_ENABLED=true
# Cap on clips the workload-gated simulator scans to build the
# (route x coverage) -> expected-yards lookup from the labeled corpus.
COUNTERFACTUAL_CORPUS_MAX_PLAYS=1000
# Caller-supplied identity/tracking/calibration confidence at or below this value
# forces experimental-only, concept-level language (never trusted coach-facing).
COUNTERFACTUAL_INPUT_CONFIDENCE_THRESHOLD=0.6

# ── Storage backend (DB-as-queue + local or S3-compatible objects) ──────────
# STORAGE_BACKEND: "local" | "s3" | "" (auto: s3 when S3_* creds are present).
# Local mode stores objects under LOCAL_STORAGE_ROOT/{bucket}/{key} and serves
# them via HMAC-signed /api/v1/storage URLs — no cloud account needed.
STORAGE_BACKEND=local
LOCAL_STORAGE_ROOT=./data/storage
# Absolute origin used when minting signed local download URLs.
PUBLIC_API_BASE_URL=http://localhost:8000

# The backend's processing_jobs table IS the job queue: the worker claims rows
# via POST /api/v1/jobs/claim (FOR UPDATE SKIP LOCKED). No message broker.
# Service account the worker logs in with (seed with `python -m scripts.seed_users`).
WORKER_EMAIL=worker@example.com
WORKER_PASSWORD=change-me-worker
# WORKER_ID=            # defaults to hostname-pid
# GPU_WORKER_LEASE_SECONDS=600
# GPU_WORKER_HEARTBEAT_INTERVAL=60

# First-run seeding (idempotent): python -m scripts.seed_users
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-admin
SEED_WORKER_EMAIL=worker@example.com
SEED_WORKER_PASSWORD=change-me-worker
# Optional: rotate seeded-user passwords during script/startup seed pass.
# Keep disabled unless intentionally recovering credentials.
SEED_RESET_PASSWORDS=0
# Optional: run the same seed pass on backend startup (cloud-safe bootstrap).
# Requires SEED_* credentials above.
SEED_USERS_ON_STARTUP=0

# Development-only conveniences (never enable in production):
# DEV_AUTOLOGIN=1       # POST /api/v1/auth/dev-login issues admin tokens
# PIPELINE_STUB=1       # deterministic stub models instead of YOLO (fast wiring checks)
