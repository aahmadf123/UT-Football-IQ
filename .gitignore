# NFL Big Data Bowl (Issue #164) — raw Kaggle data + normalized artifacts are
# OFFLINE-only and must never be committed. The synthetic sample under
# gpu-worker/datasets/bdb/sample/ is the only BDB-shaped data in the repo.
.cache/
gpu-worker/.cache/
data/bdb/**
!data/bdb/README.md

# Playwright (frontend E2E)
frontend/playwright-report/
frontend/test-results/
frontend/blob-report/

# Playwright MCP browser artifacts (agent screenshots/snapshots)
.playwright-mcp/

# HLS test byproducts written to gpu-worker/ cwd by the render tests
gpu-worker/seg_*.ts
gpu-worker/-encoders
