{
  "name": "footiq-api-edge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare Worker at the edge of Football-IQ: R2 multipart uploads, signed object streaming, cron scheduling, and proxying to the FastAPI container.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@cloudflare/containers": "^0.3.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.8",
    "@cloudflare/workers-types": "^5.20260724.1",
    "typescript": "^5.8.3",
    "vitest": "^4.1.0",
    "wrangler": "^4.114.0"
  }
}
